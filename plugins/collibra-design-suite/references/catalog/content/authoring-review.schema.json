{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chadronbryant-collibra.github.io/collibra-design-pages/schemas/authoring-review.schema.json",
  "title": "Native document authoring review",
  "description": "A local record of inspected authoring evidence. It grants no approval or publication authority, does not establish human acceptance, and cannot prove the meaning or quality of an artifact without inspection. Incomplete and failing reviews remain valid records; readiness is a separate validator mode.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "medium",
    "reader",
    "reader_question",
    "next_step",
    "main_view",
    "supporting_detail",
    "material_constraints",
    "preserve_requested_structure",
    "notes_requested",
    "notes_added",
    "native_features",
    "checks",
    "content_ready",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "medium": {
      "enum": [
        "google-doc",
        "google-sheet",
        "google-slides"
      ]
    },
    "reader": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reader_question": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "next_step": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "main_view": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "supporting_detail": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "material_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "placement"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "placement": {
            "enum": [
              "main",
              "adjacent"
            ]
          }
        }
      }
    },
    "preserve_requested_structure": {
      "type": "boolean"
    },
    "notes_requested": {
      "type": "boolean"
    },
    "notes_added": {
      "type": "integer",
      "minimum": 0
    },
    "native_features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature",
          "purpose",
          "outcome"
        ],
        "properties": {
          "feature": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "outcome": {
            "enum": [
              "applied",
              "not-needed"
            ]
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "method",
          "artifact_ref"
        ],
        "properties": {
          "id": {
            "enum": [
              "reader-intent",
              "structure-and-density",
              "native-features",
              "constraints-and-evidence",
              "requested-structure-and-notes",
              "native-and-rendered-view"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not-checked"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "artifact_ref": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "fail"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "artifact_ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "id": {
                "const": "reader-intent"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "structure-and-density"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "native-features"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "constraints-and-evidence"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "requested-structure-and-notes"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "native-and-rendered-view"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "content_ready": {
      "type": "boolean",
      "description": "True only after all six inspected checks pass. This is authoring readiness, not process-owner acceptance or permission to publish."
    },
    "approval": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "notes_requested": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "notes_added": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "content_ready": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "preserve_requested_structure": {
            "const": true
          },
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "const": "pass"
                }
              }
            }
          }
        }
      }
    }
  ]
}
