{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chadronbryant-collibra.github.io/collibra-design-pages/schemas/review-receipt.schema.json",
  "title": "Collibra design review receipt",
  "description": "A review evidence record, not an approval, release decision, or production-readiness claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact", "states", "evidence", "approval"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact": {"type": "string", "minLength": 1},
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated", "proposed", "reviewed", "confirmed"],
      "properties": {
        "generated": {"type": "array", "items": {"type": "string"}},
        "proposed": {"type": "array", "items": {"type": "string"}},
        "reviewed": {"type": "array", "items": {"type": "string"}},
        "confirmed": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "status", "method", "supports"],
        "properties": {
          "check": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["checked", "not-checked"]},
          "method": {"type": "string", "minLength": 1},
          "supports": {"type": "string", "minLength": 1}
        }
      }
    },
    "approval": {"const": false}
  }
}
