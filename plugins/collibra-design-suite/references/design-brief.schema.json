{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chadronbryant-collibra.github.io/collibra-design-pages/schemas/design-brief.schema.json",
  "title": "Collibra portable design brief",
  "description": "A closed, portable creation handoff. It records intent and sourced facts but grants no tool authority and is never persisted automatically. String values are trimmed, non-NUL, and nonempty. Fact IDs must be unique across the facts array; JSON Schema cannot express uniqueness by one object property, so consumers must enforce that cross-record invariant.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reader", "decision", "source", "output", "medium"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "reader": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000]+$"},
    "decision": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000]+$"},
    "source": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000]+$"},
    "output": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000]+$"},
    "medium": {
      "type": "string",
      "enum": ["web-app", "dashboard", "document", "deck", "speech", "message", "diagram", "ui-flow", "data-story"]
    },
    "tone": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000]+$"},
    "constraints": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000]+$"},
      "maxItems": 50,
      "uniqueItems": true
    },
    "facts": {
      "type": "array",
      "maxItems": 100,
      "description": "Fact IDs are unique across records in this array. Consumers must check ID uniqueness after schema validation.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "state", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000]+$"},
          "text": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000]+$"},
          "state": {"type": "string", "enum": ["confirmed", "proposed"]},
          "source": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000]+$"}
        }
      }
    }
  }
}
